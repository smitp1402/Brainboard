# Required — generate in Brainboard settings.
BRAINBOARD_API_KEY=

# Region your organization is hosted in: us1 (default) or apac1.
BRAINBOARD_REGION=us1

# Authorization header form. `auto` (default) tries the raw key, then `Bearer <key>`.
# Pin to `raw` or `bearer` once you know which one your account uses.
BRAINBOARD_AUTH_SCHEME=auto

# Optional overrides.
# BRAINBOARD_BASE_URL=https://api.us1.brainboard.co
# BRAINBOARD_TIMEOUT_MS=30000
